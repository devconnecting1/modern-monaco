{
  "name": "modern-monaco",
  "description": "A modern version of Monaco Editor",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./types/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "types": "./types/core.d.ts"
    },
    "./workspace": {
      "import": "./dist/workspace.mjs",
      "types": "./types/workspace.d.ts"
    },
    "./ssr": {
      "workerd": "./dist/ssr/workerd.mjs",
      "import": "./dist/ssr/index.mjs",
      "types": "./types/ssr.d.ts"
    },
    "./editor-core": {
      "import": "./dist/editor-core.mjs",
      "types": "./types/monaco.d.ts"
    },
    "./editor-worker": {
      "import": "./dist/editor-worker.mjs"
    },
    "./editor-worker-main": {
      "import": "./dist/editor-worker-main.mjs"
    },
    "./cache": {
      "import": "./dist/cache.mjs"
    },
    "./shiki": {
      "import": "./dist/shiki.mjs"
    },
    "./util": {
      "import": "./dist/util.mjs"
    },
    "./lsp": {
      "import": "./dist/lsp/index.mjs"
    },
    "./lsp/*": {
      "import": "./dist/lsp/*.mjs"
    }
  },
  "esm.sh": {
    "bundle": false
  },
  "scripts": {
    "prepublishOnly": "bun scripts/build.ts",
    "prepare": "bun scripts/patch.ts",
    "update-language-configurations": "bun scripts/update-language-configurations.ts",
    "dev": "bun scripts/dev.ts",
    "fmt": "dprint fmt",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "eslint": "eslint 'src/**/*.ts'",
    "eslint:fix": "eslint --fix 'src/**/*.ts'",
    "prettier": "prettier --check src/",
    "prettier:fix": "prettier --write src/",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/",
    "types/"
  ],
  "browser": {
    "process": false,
    "buffer": false
  },
  "sideEffects": ["dist/index.mjs"],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "9.39.5",
    "@esm.sh/import-map": "0.4.0",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-oniguruma": "4.4.3",
    "@types/bun": "1.4.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "monaco-editor-core": "0.56.0",
    "prettier": "^3.9.6",
    "tm-grammars": "1.32.11",
    "tm-themes": "1.12.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver-textdocument": "1.0.14",
    "vscode-languageserver-types": "3.18.3"
  },
  "peerDependencies": {
    "typescript": ">= 6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esm-dev/modern-monaco.git"
  },
  "license": "MIT"
}
