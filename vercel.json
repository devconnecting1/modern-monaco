{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/modern-monaco/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/modern-monaco/(.*\\.wasm)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/lazy",
      "destination": "/lazy.html"
    },
    {
      "source": "/manual",
      "destination": "/manual.html"
    },
    {
      "source": "/manual-no-workspace",
      "destination": "/manual-no-workspace.html"
    },
    {
      "source": "/ssr",
      "destination": "/ssr.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/custom-theme",
      "destination": "/custom-theme.html"
    },
    {
      "source": "/multi-theme",
      "destination": "/multi-theme.html"
    },
    {
      "source": "/css-valid-properties",
      "destination": "/css-valid-properties.html"
    },
    {
      "source": "/with-diagnostics-options",
      "destination": "/with-diagnostics-options.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    }
  ]
}
